{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Atlas",
  "version": "0.1.0",
  "identifier": "local.codex-atlas.rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Atlas",
        "width": 1100,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Codex Atlas Local",
    "shortDescription": "Codex abilities 本地索引与阅读器",
    "longDescription": "Codex Atlas 扫描本机 Codex skills、plugin skills 和能力目录，提供只读检索、详情阅读与本地元数据整理。",
    "icon": ["icons/icon.ico"]
  }
}
