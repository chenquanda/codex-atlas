{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Atlas",
  "version": "0.1.0",
  "identifier": "local.codex-atlas.rust",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Codex Atlas",
        "width": 760,
        "height": 840,
        "minWidth": 520,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
